#
# Writes the file behind profiler/build_stamp.h: the commit, whether the tree had
# uncommitted changes, and the build type. Runs on every build, and leaves the
# file untouched when nothing changed, so nothing rebuilds.
# A tree with no git, such as a source archive, stamps "unknown" and dirty.
find_package(Git QUIET)
set(_commit "unknown")
set(_dirty "true")
if(GIT_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD
        WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE _head OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE _head_rc ERROR_QUIET)
    execute_process(COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=no
        WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE _changes OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE _status_rc ERROR_QUIET)
    if(_head_rc EQUAL 0)
        set(_commit "${_head}")
        if(_status_rc EQUAL 0 AND _changes STREQUAL "")
            set(_dirty "false")
        endif()
    endif()
endif()
string(TOLOWER "${BUILD_TYPE}" _type)
if(_type STREQUAL "")
    set(_type "unknown")
endif()
set(_text "// Generated by cmake/write_build_stamp.cmake.
#include \"profiler/build_stamp.h\"

namespace Vestige
{
const char* buildStampCommit() { return \"${_commit}\"; }
bool buildStampDirty() { return ${_dirty}; }
const char* buildStampType() { return \"${_type}\"; }
} // namespace Vestige
")
file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT "${_text}" @ONLY)
